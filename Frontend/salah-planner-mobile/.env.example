# Salah Planner Mobile - Environment Configuration

# API Base URL
# Update this to point to your backend API
# Examples:
#   iOS Simulator (local):     http://localhost:5000/api
#   Android Emulator (local):  http://10.0.2.2:5000/api
#   Physical Device:           http://192.168.1.XXX:5000/api (your computer's IP)
#   Production:                https://api.salahplanner.com/api

API_BASE_URL=http://localhost:5000/api

# Default Location Settings
# These will be used as initial values in the settings screen
DEFAULT_CITY=Cairo
DEFAULT_COUNTRY=Egypt

# Default Calculation Method
# 0: Shia Ithna-Ashari
# 1: University of Islamic Sciences, Karachi
# 2: Islamic Society of North America (ISNA)
# 3: Muslim World League (MWL)
# 4: Umm Al-Qura University, Makkah
# 5: Egyptian General Authority of Survey (Default)
# 8: Gulf Region
# 9: Kuwait
# 10: Qatar
# 17: JAKIM (Malaysia)
DEFAULT_CALCULATION_METHOD=5

# App Configuration
APP_NAME=Salah Planner
APP_VERSION=1.0.0

# MMKV Encryption Key (keep this secret in production!)
MMKV_ENCRYPTION_KEY=salah-planner-secret-key-2024
